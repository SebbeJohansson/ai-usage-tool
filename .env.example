# --- Claude.ai quota meters (session + weekly bars) for one account ---
#   CLAUDE_ORG_ID      the org id segment of any claude.ai/settings URL
#   CLAUDE_SESSION_KEY the value of the `sessionKey` cookie for a logged-in
#                       claude.ai browser tab (DevTools → Application →
#                       Cookies); this cookie rotates, so expect to swap it
#                       in again after it goes stale
CLAUDE_ORG_ID=
CLAUDE_SESSION_KEY=

# --- GitHub Copilot AI-credit usage for one github.com login ---
#   GITHUB_TOKEN a token with org billing/admin read access (classic PAT:
#                manage_billing:copilot + read:org; fine-grained PAT: org
#                "Administration" read permission)
#   GITHUB_ORG   the org that grants the Copilot seat
#   GITHUB_USER  the login being watched
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_USER=

# Discord webhook that alerts get posted to.
DISCORD_WEBHOOK_URL=

# Poll cadence, Go duration syntax. Default: 15m
CHECK_INTERVAL=15m

# Where the alert ledger (steps already announced) lives on disk.
# Default: data/state.json (the Dockerfile points this at /app/data/state.json).
STATE_FILE=
